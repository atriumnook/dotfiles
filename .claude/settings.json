{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "cleanupPeriodDays": 99999,
  "effortLevel": "high",
  "enabledPlugins": {
    "codex@openai-codex": true,
    "mattpocock-skills@claude-plugins-official": true,
    "prompt-rail@atnook-dotfiles": true,
    "sitrep@atnook-dotfiles": true
  },
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "125000",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_EXTRA_USAGE_COMMAND": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_INSTALLATION_CHECKS": "1",
    "ENABLE_TOOL_SEARCH": "1"
  },
  "extraKnownMarketplaces": {
    "atnook-dotfiles": {
      "source": {
        "repo": "atriumnook/dotfiles",
        "source": "github"
      }
    },
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    }
  },
  "fileSuggestion": {
    "command": "bun ~/.claude/bun-file-suggestion.mjs",
    "type": "command"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "f=\"$HOME/.claude/hooks/herdr-agent-state.sh\"; [ ! -f \"$f\" ] || bash \"$f\" session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^(startup|resume|clear|compact|fork)$"
      }
    ]
  },
  "language": "japanese",
  "model": "opus",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "permissions": {
    "allow": [],
    "ask": [],
    "deny": []
  },
  "remoteControlAtStartup": true,
  "respectGitignore": true,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "bun ~/.claude/bun-braille-dots-statusline.mjs",
    "refreshInterval": 60,
    "type": "command"
  }
}
