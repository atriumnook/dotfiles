[settings]
experimental = true
lockfile = true
disable_backends = ["asdf", "vfox"]

[settings.pipx]
uvx = true

[tools]
# --- Runtimes ---
node = "26"
bun = "1"
uv = "0"

# --- CLI Tools (cross-platform) ---
"github:rossmacarthur/sheldon" = "0"
atuin = "18"
chezmoi = "2"
delta = "0"
starship = "1"
yazi = "26"
zellij = "0"
usage = "3"
ast-grep = "0"
vp = "0"

# AI
claude = "latest"
"github:microsoft/apm" = "0"
"github:ogulcancelik/herdr" = "0"

{{- if or (.chezmoi.kernel.osrelease | lower | contains "microsoft") (eq .chezmoi.osRelease.id "debian") }}
# --- CLI Tools (WSL / Debian) ---
bat = "0"
eza = "0"
fd = "10"
fzf = "0"
jq = "1"
lazygit = "0"
neovim = "0"
ripgrep = "15"
zoxide = "0"
{{- if eq (get . "profile" | default "personal") "personal" }}
# --- Personal profile only (仕事 PC では不要) ---
gh = "2"
# AI
codex = "latest"
antigravity-cli = "latest"
{{- end }}
{{- end }}
