{{- $profile := get . "profile" | default "personal" | lower -}}
{{- $isPersonal := eq $profile "personal" -}}

{{- $os := .chezmoi.os -}}
{{- $isLinux := eq $os "linux" -}}
{{- $isWindows := eq $os "windows" -}}

{{- $kernel := get .chezmoi "kernel" | default (dict) -}}
{{- $kernelRelease := get $kernel "osrelease" | default "" | lower -}}
{{- $isWsl := and $isLinux (contains "microsoft" $kernelRelease) -}}

{{- $osRelease := get .chezmoi "osRelease" | default (dict) -}}
{{- $distroId := get $osRelease "id" | default "" | lower -}}
{{- $distroIdLike := get $osRelease "idLike" | default "" | lower -}}

{{- $isDebianFamily := and
      $isLinux
      (or
        (eq $distroId "debian")
        (eq $distroId "ubuntu")
        (contains "debian" $distroIdLike)
      )
-}}

{{- $isWslOrDebian := or $isWsl $isDebianFamily -}}
{{- $isOmarchy := eq (.chezmoi.hostname | lower) "omarchy" -}}

[settings]
lockfile = true
disable_backends = ["asdf", "vfox"]

[tools]
# --- Runtimes ---
node = "26"
bun = "1"
uv = "0"

# --- CLI Tools: Windows / Linux ---
age = "1"
ast-grep = "0"
atuin = "18"
chezmoi = "2"
delta = "0"
fd = "10"
fzf = "0"
jq = "1"
ripgrep = "15"
starship = "1"
usage = "3"
yazi = "26"

# --- AI Tools ---
claude = "latest"
apm = "0"
"npm:hunkdiff" = "0"
"github:tomasz-tomczyk/crit" = "0"
"github:yusukebe/ax" = "0"

{{ if $isLinux }}
sheldon = "0"
"github:ogulcancelik/herdr" = "0"
{{ end }}

{{ if $isWslOrDebian }}
bat = "0"
eza = "0"
lazygit = "0"
neovim = "0"
zoxide = "0"
{{ end }}

{{ if $isPersonal }}
github-cli = "2"
buf = "1"
bitwarden = "2026.6.0"

# AI
codex = "latest"
antigravity-cli = "latest"
"github:router-for-me/CLIProxyAPI" = "7"
{{ end }}

{{ if $isOmarchy }}
dotnet = "8"
{{ end }}
