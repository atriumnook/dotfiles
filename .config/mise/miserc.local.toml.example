# このファイルを mise の設定ディレクトリ(既定は ~/.config/mise、MISE_CONFIG_DIR で変更可)に
# miserc.local.toml としてコピーし、マシンに合わせて編集する。
# miserc.local.toml は他の config より先に読み込まれ、どの environment を有効化するかを宣言する
# (mise 公式の推奨手段)。env は次の 3 軸から選ぶ:
#   profile : personal / work
#   OS      : linux / windows          ← OS 別 dotfiles(config.<os>.toml)を有効化
#   class   : omarchy / wsldebian      ← Linux のマシンクラス(任意)
#   module  : cli / personal-cli       ← omarchy 以外の機で、omarchy が提供するツールを補う
#             cli は omarchy 以外の全マシン、personal-cli はそのうち profile=personal のマシンが選ぶ
#
# 例:
#   個人 omarchy 機      -> env = ["personal", "linux", "omarchy"]
#   個人 WSL/Debian 機    -> env = ["personal", "linux", "wsldebian", "cli", "personal-cli"]
#   仕事 WSL/Debian 機    -> env = ["work", "linux", "wsldebian", "cli"]
#   個人 Windows 機       -> env = ["personal", "windows", "cli", "personal-cli"]
env = ["personal", "linux", "omarchy"]
