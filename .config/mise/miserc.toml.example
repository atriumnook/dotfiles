# このファイルを ~/.config/mise/miserc.toml にコピーし、マシンに合わせて編集する。
# miserc.toml は他の config より先に読み込まれ、どの environment を有効化するかを宣言する
# (mise 公式の推奨手段)。env は profile(personal/work)× マシンクラス(omarchy/wsldebian)を選ぶ。
# 例:
#   個人 omarchy 機    -> env = ["personal", "omarchy"]
#   個人 WSL/Debian 機  -> env = ["personal", "wsldebian"]
#   仕事 WSL/Debian 機  -> env = ["work", "wsldebian"]
env = ["personal", "omarchy"]
